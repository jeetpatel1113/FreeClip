# =============================================================================
# FreeClip configuration. Copy to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- Required secrets ---------------------------------------------------------
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
# 64 hex chars (32 bytes). Encrypts social OAuth tokens at rest. Do not change it after you store tokens.
ENCRYPTION_KEY=

# --- Google Gemini (required) -------------------------------------------------
# 1. Sign in at https://aistudio.google.com
# 2. Get API key -> Create API key (pick or create a Google Cloud project)
# 3. Paste it here. Used for clip curation and the publishing agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL is overloaded (503/429) or not available to your key (404).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Safety filter for transcripts (podcasts and streams often contain profanity):
# BLOCK_NONE | BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE | OFF
GEMINI_SAFETY_THRESHOLD=BLOCK_NONE
# -1 = dynamic thinking, 0 = off (Flash models only), >0 = thinking token budget
GEMINI_THINKING_BUDGET=-1

# --- Networking ---------------------------------------------------------------
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Browsers upload to and play from MinIO directly through presigned URLs, so this must be
# reachable from the browser. Instagram also fetches Reels from it, so for Instagram it must
# be a PUBLIC https URL (for example https://media.example.com proxied to s3:9000).
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=freeclip
S3_BUCKET=freeclip
# Optional: require a bearer token on the REST API. The web container injects it server-side.
API_AUTH_TOKEN=

# --- Transcription / rendering ------------------------------------------------
# tiny | base | small | medium | large-v3 | distil-large-v3. large-v3 needs a GPU for reasonable speed.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
# 1 = refine word timestamps with whisperx (pip install whisperx in the worker image).
USE_WHISPERX=0
# auto | nvenc | cpu
FFMPEG_ENCODER=auto
PIPELINE_CONCURRENCY=1
MAX_SOURCE_MINUTES=240

# --- B-roll (optional) --------------------------------------------------------
# Free key: https://www.pexels.com/api/ -> "Get started" -> copy your API key.
PEXELS_API_KEY=

# --- Publishing ---------------------------------------------------------------
# 1 = the agent runs end to end but no upload request is sent (good for testing).
PUBLISH_DRY_RUN=0
PUBLISH_CONCURRENCY=2
# Unaudited TikTok apps may only post SELF_ONLY. Use PUBLIC_TO_EVERYONE once your app passes audit.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
YOUTUBE_PRIVACY_STATUS=public

# Social account tokens are NOT set here. Enter them in the web UI under
# "Accounts & Automation", where they are encrypted in Postgres. How to get them:
#
# INSTAGRAM (Graph API, Reels publishing)
#   1. Convert the Instagram account to Business or Creator and link it to a Facebook Page.
#   2. https://developers.facebook.com -> Create App (type: Business) -> add "Instagram Graph API".
#   3. Graph API Explorer: request instagram_basic, instagram_content_publish, pages_show_list,
#      pages_read_engagement, then generate a user token and exchange it for a long-lived token
#      (GET /oauth/access_token?grant_type=fb_exchange_token...).
#   4. GET /me/accounts -> your Page -> GET /{page-id}?fields=instagram_business_account
#      gives the "Instagram user ID".
#
# TIKTOK (Content Posting API)
#   1. https://developers.tiktok.com -> Manage apps -> Create app; add Login Kit + Content Posting API
#      ("Direct Post"), scopes user.info.basic and video.publish.
#   2. Copy the Client key and Client secret.
#   3. Run the OAuth flow (https://www.tiktok.com/v2/auth/authorize/) and exchange the code at
#      https://open.tiktokapis.com/v2/oauth/token/ for an access + refresh token.
#   Until the app is audited, posts are limited to private (SELF_ONLY) visibility.
#
# YOUTUBE (Data API v3)
#   1. https://console.cloud.google.com -> new project -> enable "YouTube Data API v3".
#   2. OAuth consent screen (External; add yourself as a test user), then create Credentials ->
#      OAuth client ID (Desktop app or Web app).
#   3. Get a refresh token with scope https://www.googleapis.com/auth/youtube.upload (for example
#      via https://developers.google.com/oauthplayground with "Use your own OAuth credentials").
#   4. Enter the client ID, client secret and refresh token. Access tokens are refreshed automatically.
#   Note: videos from unverified API projects are locked private until Google audits the project.
#
# X / TWITTER (API v2, paid tier with media upload)
#   1. https://developer.x.com -> Project & App -> User authentication settings: OAuth 2.0,
#      type Web App / Native App, scopes tweet.read tweet.write users.read media.write offline.access.
#   2. Run the OAuth 2.0 PKCE flow to get a user access token + refresh token.
#
# LINKEDIN (Community Management / Share on LinkedIn)
#   1. https://www.linkedin.com/developers -> Create app; request "Share on LinkedIn"
#      (w_member_social) or Community Management API (w_organization_social).
#   2. Generate a token with the OAuth tools in the developer portal.
#   3. Author URN: urn:li:person:{id from GET /v2/userinfo "sub"} or urn:li:organization:{id}.
